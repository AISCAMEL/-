# =====================================================================
# 合同会社アイズ 会計 ― サーバー/自動化の設定（server/.env）
# `node server/setup.js` で雛形を作成し、必要な値を埋めてください。
# このファイルはコピー元の例です。実際の値は server/.env に書きます。
# =====================================================================

# --- 同期サーバー ---
PORT=8787
# 会計アプリと同じワークスペース名・トークン（アプリの「設定→クラウド同期」と一致させる）
WORKSPACE=aizu-2026
TOKEN=合言葉をここに

# --- AI連携（任意：AI講評・OCRを使う場合） ---
# AI_API_KEY=sk-...
# AI_PROVIDER=anthropic           # anthropic | openai
# AI_MODEL=
# AI_API_BASE=

# --- 通知の宛先 ---
ALERT_TO=owner@example.com

# --- Gmail送信/取込 OAuth（gmail.readonly + gmail.send） ---
# 取得方法は `node server/gmail-token.js` の案内を参照
# GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=xxxxx
# GMAIL_REFRESH_TOKEN=xxxxx
# GMAIL_PDF_PASSWORDS=12345        # USS精算書PDFのパスワード（会員番号5桁・カンマ区切り可）

# --- AI監視アラートのしきい値 ---
WATCH_MIN_LEVEL=warn               # bad | warn | info

# --- 決済コネクタ（使う場合だけ値を入れる） ---
# STRIPE_API_KEY=sk_live_...
# SQUARE_ACCESS_TOKEN=...
# PAYPAL_CLIENT_ID=...
# PAYPAL_SECRET=...

# --- スケジュール（省略可。既定値で自動運用） ---
# SCHED_GMAIL_MIN=30               # Gmail取込の間隔（分）
# SCHED_PAY_MIN=60                 # 決済コネクタの間隔（分）
# SCHED_STOCK_HHMM=08:00           # 在庫アラート送信時刻
# SCHED_AIWATCH_HHMM=08:30         # AI監視アラート送信時刻
# SCHED_MONTHLY_DOM=1              # 月次レポート送信日（毎月N日）
# SCHED_MONTHLY_HHMM=08:00         # 月次レポート送信時刻
# SCHED_NO_SERVER=0                # 1 にすると同期サーバーを起動しない（別で起動済みの場合）
