# IWASAWA SURF BASE — 環境変数サンプル
# Supabase プロジェクト作成後、この内容を .env.local にコピーして値を入れてください。
# （.env.local は Git にコミットされません）

# Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...（anon public キー）

# サイトのベースURL（メール確認リンクのリダイレクト先などに使用）
# このアプリは 3200 番ポートで起動します（3000は別アプリ用）
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── 外部連携（各サービスの加盟店アカウント・APIキーが必要）──
# 決済：Square（講座/プレミアムのサブスク・対面決済）
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=

# 物販：BASE（オンラインショップ本体・仕入れ先商品の自動掲載）
BASE_API_ACCESS_TOKEN=
NEXT_PUBLIC_BASE_SHOP_URL=

# 販売チャネル（多店舗展開）
RAKUTEN_API_KEY=
YAHOO_API_KEY=
AMAZON_SP_API_TOKEN=
